# Copy to deploy/docker/.env and replace every placeholder.
# Generate each value independently with: openssl rand -hex 32
# CYBERGUARDIAN_API_KEY is the human/admin API credential; do not give it to workloads.
CYBERGUARDIAN_API_KEY=replace-with-admin-api-key-from-setup

# Workload credentials are distinct from the administrator credential and from each other.
CG_DASHBOARD_API_KEY=replace-with-unique-dashboard-service-key
CG_NAD_API_KEY=replace-with-unique-nad-service-key

# Shared only by the dashboard backend and API gateway; never expose to the browser.
CG_OPERATOR_ASSERTION_SECRET=replace-with-unique-operator-assertion-secret

# Generate independently with: openssl rand -hex 32
DECISION_SERVICE_API_KEY=replace-with-unique-decision-service-key

CG_PRODUCTION=1
CG_REQUIRE_AGENT_IDENTITY=1
CG_COOKIE_SECURE=1
# Comma-separated proxy CIDRs allowed to supply X-Forwarded-For; leave blank if none.
CG_TRUSTED_PROXY_IPS=

# Exact browser origins only; do not use wildcard origins.
CG_ALLOWED_ORIGINS=https://your-dashboard.example

# Relative to deploy/docker; persists credentials, API data and dashboard sessions.
CG_DATA_HOST_DIR=../../data
